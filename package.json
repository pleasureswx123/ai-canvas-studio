{
  "name": "my-canvas-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,media,web -c yellow,magenta,cyan \"npm run dev:api\" \"npm run dev:media\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/node-api/index.js",
    "dev:media": "python server/media-service/app.py",
    "env:check": "node scripts/check-env.mjs",
    "ui:check": "node scripts/check-native-dialogs.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:js && npm run test:py",
    "test:js": "node --test \"test/*.test.mjs\"",
    "test:py": "python -m unittest discover -s test -p \"*.py\"",
    "test:e2e": "playwright test",
    "verify": "npm run env:check && npm run ui:check && npm run lint && npm test && npm run build && npm run smoke:api",
    "verify:e2e": "npm run verify && npm run test:e2e",
    "preview": "vite preview",
    "smoke:api": "node scripts/smoke-api.mjs",
    "legacy:preview": "node scripts/legacy-import.mjs --source",
    "legacy:materials": "node scripts/legacy-material-import.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "^12.10.2",
    "concurrently": "^9.2.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^8.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.7.4"
  }
}
