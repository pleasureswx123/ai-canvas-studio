NODE_API_PORT=8787
MEDIA_SERVICE_PORT=8790
MEDIA_SERVICE_ORIGIN=http://127.0.0.1:8790

# Comma-separated providers. Keep mock for local development.
# Supported now: mock, openai_image, vectorengine_image, ark_video, dashscope_video, xunke_video
MEDIA_PROVIDER=mock

# OpenAI-compatible image generation. Also works for compatible gateways
# when OPENAI_IMAGE_BASE_URL and OPENAI_IMAGE_MODEL are set.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# Volcengine Ark-compatible image/video settings.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128

# VectorEngine / Gemini-compatible image relay.
VECTORENGINE_API_KEY=
VECTORENGINE_BASE_URL=https://api.vectorengine.ai/v1
VECTORENGINE_IMAGE_MODEL=gemini-3-pro-image-preview

# DashScope image-to-video task API.
DASHSCOPE_API_KEY=
DASHSCOPE_VIDEO_MODEL=wan2.7-i2v

# Xunke/KKAI Seedance video API.
XUNKE_API_KEY=
XUNKE_BASE_URL=https://api.xunkecloud.cn
XUNKE_VIDEO_MODEL_SEEDANCE_2_0=seed-2-480p
XUNKE_VIDEO_MODEL_SEEDANCE_2_0_720P=seed-2-720p

# Local-only Seedance review test mode. Real review integration can replace
# this endpoint while preserving the same MaterialItem.seedanceFaceReview schema.
SEEDANCE_REVIEW_MODE=
